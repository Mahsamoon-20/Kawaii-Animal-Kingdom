<script>
function openModal(id) {
  var el = document.getElementById(id);
  if (el) { el.style.display = 'flex'; el.classList.add('open'); }
}
function closeModal(id) {
  var el = document.getElementById(id);
  if (el) { el.style.display = 'none'; el.classList.remove('open'); }
}
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    document.querySelectorAll('.modal-overlay.open').forEach(function(m) {
      m.style.display = 'none'; m.classList.remove('open');
    });
  }
});

// BUBBLE CANVAS
const cvs = document.getElementById('bubble-canvas');
const ctx = cvs.getContext('2d');
let bubbles = [];
function resizeCvs() { cvs.width = window.innerWidth; cvs.height = window.innerHeight; }
resizeCvs();
window.addEventListener('resize', resizeCvs);
function spawnBubbles(x, y, n) {
for (let i = 0; i < n; i++) {
bubbles.push({
x, y,
r: 4 + Math.random() * 7,
vx: (Math.random() - 0.5) * 2.2,
vy: -(1.5 + Math.random() * 2.5),
alpha: 0.75,
color: Math.random() > 0.5 ? '#F9A8C9' : '#C9B8F5'
});
}
}
function animBubbles() {
ctx.clearRect(0, 0, cvs.width, cvs.height);
bubbles = bubbles.filter(b => b.alpha > 0.02);
bubbles.forEach(b => {
b.x += b.vx; b.y += b.vy; b.alpha *= 0.96;
ctx.beginPath();
ctx.arc(b.x, b.y, b.r, 0, Math.PI * 2);
ctx.strokeStyle = b.color;
ctx.lineWidth = 1.5;
ctx.globalAlpha = b.alpha;
ctx.stroke();
ctx.globalAlpha = b.alpha * 0.18;
ctx.fillStyle = b.color;
ctx.fill();
ctx.globalAlpha = 1;
});
requestAnimationFrame(animBubbles);
}
animBubbles();
document.addEventListener('click', function(e) {
spawnBubbles(e.clientX, e.clientY, 5);
});
</script>
